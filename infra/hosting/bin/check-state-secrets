#!/usr/bin/env bash
# Fails if tofu state holds the tunnel token, a tunnel secret, or a credential from .env.
# Reads the state from the S3 backend with `tofu state pull`.
set -euo pipefail
# shellcheck source=bin/_lib.sh
. "$(dirname "$0")/_lib.sh"

tofu -chdir="$root" state pull > "$tmp/state.json"
[ -s "$tmp/state.json" ] || die "state is empty; has apply run?"
tofu -chdir="$root" show -json > "$tmp/show.json"

needles="$tmp/needles"
: > "$needles"
chmod 600 "$needles"
if [ -n "$(out tunnel_id)" ]; then
  fetch_tunnel_token "$tmp/token"
  cat "$tmp/token" >> "$needles"
  echo >> "$needles"
fi
printf '%s\n%s\n' "$CLOUDFLARE_API_TOKEN" "${AWS_SECRET_ACCESS_KEY:-}" | { grep -v '^$' || true; } >> "$needles"

fail=0
for f in "$tmp/state.json" "$tmp/show.json"; do
  name="$(basename "$f")"
  if grep -qF -f "$needles" "$f"; then
    echo "FAIL: a token or credential value is in $name"
    fail=1
  fi
  if grep -q 'TunnelSecret' "$f" ||
    jq -e '[paths(type == "string") as $p | select($p[-1] == "tunnel_secret") | getpath($p) | select(. != "")] | length > 0' "$f" >/dev/null; then
    echo "FAIL: a tunnel secret is in $name"
    fail=1
  fi
done
[ "$fail" = 0 ] && echo "PASS: no tunnel token, tunnel secret, or .env credential in tofu state"
exit "$fail"
