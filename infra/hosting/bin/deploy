#!/usr/bin/env bash
# Usage: bin/deploy <build-context-dir>
# Builds a linux/arm64 image, pushes it to ECR, then restarts the compose stack on the server via SSM.
# Only non-secret values travel in the SSM command; the server fetches secrets itself.
set -euo pipefail
# shellcheck source=bin/_lib.sh
. "$(dirname "$0")/_lib.sh"

ctx="${1:?usage: bin/deploy <build-context-dir>}"
[ -f "$ctx/Dockerfile" ] || die "$ctx/Dockerfile not found"

project="$(out project)"
region="$(out region)"
instance_id="$(out instance_id)"
repo="$(out ecr_repository_url)"
mode="$(out ingress_mode)"
fqdn="$(out fqdn)"
app_port="$(out app_port)"
[ -n "$instance_id" ] || die "no instance in tofu outputs; run bin/tf apply first"

tag="$(date -u +%Y%m%d%H%M%S)-$(git -C "$ctx" rev-parse --short HEAD 2>/dev/null || echo nogit)"
image="$repo:$tag"

echo "==> build + push $image"
aws ecr get-login-password --region "$region" |
  docker login --username AWS --password-stdin "${repo%%/*}" >/dev/null
docker buildx build --platform linux/arm64 --provenance=false -t "$image" --push "$ctx"

echo "==> wait for the server to be reachable through SSM"
for _ in $(seq 1 60); do
  ping="$(aws ssm describe-instance-information --region "$region" \
    --filters "Key=InstanceIds,Values=$instance_id" --query 'InstanceInformationList[0].PingStatus' --output text)"
  [ "$ping" = Online ] && break
  sleep 5
done
[ "$ping" = Online ] || die "SSM agent on $instance_id is not online (status: $ping)"

b64() { base64 < "$1" | tr -d '\n'; }
script="set -euo pipefail
install -d -m 0700 /opt/app
cd /opt/app
echo '$(b64 "$root/server/compose.yml")' | base64 -d > compose.yml
echo '$(b64 "$root/server/Caddyfile")' | base64 -d > Caddyfile
echo '$(b64 "$root/server/remote-deploy.sh")' | base64 -d > remote-deploy.sh
bash remote-deploy.sh '$image' '$mode' '$app_port' '$fqdn' '$region' '$project'"
jq -n --arg c "$script" '{commands: [$c], executionTimeout: ["900"]}' > "$tmp/params.json"

echo "==> deploy on $instance_id (ingress_mode=$mode)"
cmd_id="$(aws ssm send-command --region "$region" --instance-ids "$instance_id" \
  --document-name AWS-RunShellScript --comment "deploy $tag" \
  --parameters "file://$tmp/params.json" --query Command.CommandId --output text)"

status=Pending
for _ in $(seq 1 200); do
  sleep 5
  status="$(aws ssm get-command-invocation --region "$region" --command-id "$cmd_id" \
    --instance-id "$instance_id" --query Status --output text 2>/dev/null || echo Pending)"
  case "$status" in Pending | InProgress | Delayed) ;; *) break ;; esac
done
aws ssm get-command-invocation --region "$region" --command-id "$cmd_id" --instance-id "$instance_id" \
  --query StandardOutputContent --output text
aws ssm get-command-invocation --region "$region" --command-id "$cmd_id" --instance-id "$instance_id" \
  --query StandardErrorContent --output text >&2
[ "$status" = Success ] || die "deploy command $cmd_id finished with status $status"

echo "==> check https://$fqdn/"
code=000
for _ in $(seq 1 30); do
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://$fqdn/" || true)"
  case "$code" in 2?? | 3??)
    echo "https://$fqdn/ -> HTTP $code ($image)"
    exit 0
    ;;
  esac
  sleep 5
done
die "https://$fqdn/ did not answer 2xx/3xx (last: HTTP $code)"
