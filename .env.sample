# Copy to .env and fill in your OpenAI project key.
OPENAI_API_KEY=

# Infra-Phone WebRTC demo defaults.
OPENAI_REALTIME_MODEL=gpt-realtime
PHONE_DEMO_PORT=8783

# Leave the bucket empty to save history locally.
# For S3, get the bucket name with: tofu -chdir=Infra-Phone output -raw conversation_bucket_name
PHONE_HISTORY_BUCKET=
PHONE_HISTORY_PROFILE=bsirikxm
PHONE_HISTORY_REGION=ap-southeast-1
# PHONE_HISTORY_DIR=./.history/

# Required by the Agent Studio API for its separate voice demo.
VOICE_DEMO_CODE=
